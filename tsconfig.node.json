{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    // 없으면 vue-tsc -b 가 vite.config.ts 를 컴파일해 vite.config.js 를 만든다.
    // Vite 는 .js 를 .ts 보다 먼저 로드하므로, 그 순간부터 앱이 낡은 컴파일본을
    // 설정으로 쓰게 된다. 타입 검사만 하고 산출물은 내지 않는다.
    "noEmit": true
  },
  "include": ["vite.config.ts"]
}
