# ──────────────────────────────────────────────────────────────
# Tikkle 환경변수 템플릿
#   이 파일을 복사해 `.env` 를 만들고 실제 값으로 채우세요:
#     cp .env.example .env
#   `.env` 는 .gitignore 에 의해 커밋되지 않습니다.
# ──────────────────────────────────────────────────────────────

# 백엔드 API 베이스 URL (예: https://api.example.com)
VITE_API_BASE_URL=

# 결제 스크래핑(POST /api/payments) HMAC-SHA256 서명용 시크릿
# 백엔드와 동일한 값을 사용해야 서명 검증이 통과합니다.
VITE_PAYMENT_SECRET_KEY=

# 개발용 인증 우회: true 면 실제 로그인 없이 목 프로필로 앱을 띄웁니다.
# 운영/실기기 빌드에서는 반드시 false 또는 미설정.
VITE_SKIP_AUTH=false

# 데모/스크린샷용 목 데이터: true 면 홈 보유자산과 결제 내역을 예시 데이터로
# 대체합니다(src/mocks). 로그인 여부와 무관하게 동작합니다.
#
# 실기기·AVD 스크린샷은 이 값을 직접 켜는 대신 데모 빌드를 쓰세요:
#   npm run build:demo && npx cap sync    (.env.demo 에서 자동으로 켜짐)
# 운영 빌드(`npm run build`)는 MODE=production 이라 코드 레벨에서 강제로 꺼집니다.
VITE_USE_MOCK=false
